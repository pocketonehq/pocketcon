<% meta('title', 'Register') %>
<section class="page">
  <h1 class="page-title">Register</h1>
  <p class="lede">Free. You'll get the stream link and schedule by email, and you can vote for the after-hours deep dives.</p>

  <div data-signed-in hidden>
    <p class="ok">You're registered as <b data-email></b>. See you on February 6.</p>
    <div class="actions">
      <a class="btn primary" href="/dashboard">Go to your dashboard</a>
      <a class="btn highlight" href="/speak">Propose a talk</a>
      <button class="btn" type="button" data-sign-out>Sign out</button>
    </div>
  </div>

  <%- include('oauth-buttons') %>

  <form class="form" id="auth-form" data-signed-out>
    <label>Email <input name="email" type="email" autocomplete="email" required /></label>
    <label>Password <input name="password" type="password" autocomplete="new-password" minlength="8" required /></label>
    <p class="hint">At least 8 characters. By registering you agree to the <a href="/terms">terms</a> and <a href="/privacy">privacy policy</a>.</p>
    <div class="actions">
      <button class="btn primary" type="submit">Register</button>
      <a class="btn" data-signin href="/signin">I'm already registered</a>
    </div>
    <p class="error" data-error hidden></p>
  </form>
</section>

<script>
  document.addEventListener('pocketcon:ready', () => {
    const form = document.getElementById('auth-form')
    const goNext = () => {
      const next = new URLSearchParams(location.search).get('next')
      location.href = next && next.startsWith('/') && !next.startsWith('//') ? next : '/dashboard'
    }

    // "I'm already registered" goes to /signin and keeps ?next.
    const next = new URLSearchParams(location.search).get('next')
    if (next && next.startsWith('/') && !next.startsWith('//')) form.querySelector('[data-signin]').href = '/signin?next=' + encodeURIComponent(next)

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const { email, password } = Object.fromEntries(new FormData(form))
      await PocketCon.run(form, async () => {
        await PocketCon.pb.collection('users').create({ email, password, passwordConfirm: password })
        await PocketCon.pb.collection('users').authWithPassword(email, password)
        goNext()
      })
    })
  })
</script>
