<%
  const event = ctx.resolve('event')
  const talk = ctx.resolve('talks').find(ctx.app, ctx.params.id)
  if (!talk) throw ctx.httpError(404, 'That talk is not on the agenda.')
  meta('title', talk.title)
  meta('description', `${talk.kind} by ${talk.speaker} at PocketCon 2027, ${event.date}.`)
  const paragraphs = (text) => text.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean)
%>
<article class="page talk-page">
  <p class="tag"><%= talk.kind %></p>
  <h1 class="page-title"><%= talk.title %></h1>
  <p class="speaker"><b><%= talk.speaker %></b><% if (talk.headline) { %>, <%= talk.headline %><% } %></p>
  <p class="note">PocketCon 2027 · <%= event.date %> · live on Discord</p>

  <h2>About the talk</h2>
  <% paragraphs(talk.abstract).forEach((p) => { %><p><%= p %></p><% }) %>

  <% if (talk.bio) { %>
    <h2>About <%= talk.speaker %></h2>
    <% paragraphs(talk.bio).forEach((p) => { %><p><%= p %></p><% }) %>
  <% } %>

  <% if (talk.links.length) { %>
    <h2>Links</h2>
    <ul class="talk-links">
      <% talk.links.forEach((l) => { %><li><a href="<%= l %>" rel="noopener"><%= l.replace(/^https?:\/\//, '') %></a></li><% }) %>
    </ul>
  <% } %>

  <div class="actions">
    <a class="btn primary" href="/register" data-account="Register">Register</a>
    <a class="btn" href="/#agenda">Full agenda</a>
  </div>
</article>
