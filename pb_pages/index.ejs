<%
  const event = ctx.resolve('event')
  // The fixed program; accepted talk proposals (in the admin's sort order) go after the demo, then the open slot.
  const program = [
    { kind: 'Opening keynote', title: "PocketOne and what's next", speaker: 'Ben Allfree', note: 'Expect launches.' },
    { kind: 'Guest keynote', title: 'To be announced' },
    { kind: 'Live demo', title: 'Zero to deployed with an AI agent', speaker: 'Ben Allfree', note: 'An app built and shipped with an agent, live.' },
  ]
  const talks = ctx.resolve('talks').accepted(ctx.app)
  const closing = [
    { kind: 'Panel', title: 'Agentic PocketBase' },
    { kind: 'Closing', title: "Q&A and what's next", speaker: 'Ben Allfree' },
  ]
  const agenda = program.concat(talks)
%>
<section class="hero">
  <h1 class="visually-hidden">PocketCon 2027 · <%= event.date %> · free livestream on Discord</h1>
  <div class="splash"><%- ctx.resolve('splash.svg', { mode: 'raw' }) %></div>
  <p class="lede">A day for the PocketBase community: where it stands, where it's going, and what people are building with it.</p>
  <p class="when"><%= event.date %> · starts <%= event.time %> · free and online</p>

  <div class="countdown" id="countdown" data-starts="<%= event.startsAt %>" aria-live="polite">
    <div><b data-unit="d">--</b><span>days</span></div>
    <div><b data-unit="h">--</b><span>hours</span></div>
    <div><b data-unit="m">--</b><span>min</span></div>
    <div><b data-unit="s">--</b><span>sec</span></div>
  </div>

  <div class="actions">
    <a class="btn primary" href="/register" data-account="Register">Register</a>
    <a class="btn" href="<%= event.discord %>">Join the Discord</a>
    <a class="btn" href="/pocketcon-2027.ics">Add to calendar</a>
  </div>
</section>

<section class="agenda" id="agenda">
  <h2>Agenda</h2>
  <ol>
    <% agenda.forEach((item, i) => { %>
      <li<%- item.id ? ' class="talk"' : '' %>>
        <% if (item.id) { %><a href="/talks/<%= item.id %>"><% } %>
        <span class="num"><%= String(i + 1).padStart(2, '0') %></span>
        <div>
          <p class="tag"><%= item.kind %></p>
          <h3><%= item.title %></h3>
          <% if (item.speaker) { %><p><%= item.speaker %><%= item.headline ? `, ${item.headline}` : '' %></p><% } %>
          <% if (item.note) { %><p class="note"><%= item.note %></p><% } %>
        </div>
        <% if (item.id) { %></a><% } %>
      </li>
    <% }) %>
    <li class="open-slot">
      <a href="/speak">
        <span class="num"><%= String(agenda.length + 1).padStart(2, '0') %></span>
        <div>
          <p class="tag">Talks and lightning rounds</p>
          <h3>Your talk here</h3>
          <p>Agentic PocketBase, PocketPages, migrating to 0.23+, or what you built. Propose a talk or a five-minute lightning demo →</p>
        </div>
      </a>
    </li>
    <% closing.forEach((item, i) => { %>
      <li>
        <span class="num"><%= String(agenda.length + 2 + i).padStart(2, '0') %></span>
        <div>
          <p class="tag"><%= item.kind %></p>
          <h3><%= item.title %></h3>
          <% if (item.speaker) { %><p><%= item.speaker %></p><% } %>
        </div>
      </li>
    <% }) %>
  </ol>
</section>

<section class="sponsors" id="sponsors">
  <h2>Sponsors</h2>
  <%- include('sponsor-grid') %>
</section>

<script src="/countdown.js?v=2026-11-14h" defer></script>
